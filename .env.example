# 복사해서 .env.local 로 쓰고, Vercel/GitHub 에는 같은 이름으로 비밀값을 등록하세요.

# Neon 등 Postgres 접속 주소
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# 로그인 정보·여권번호 등을 암호화하는 키 (npm run gen-key 로 생성, 32바이트 base64)
ENCRYPTION_KEY=

# 관리자 로그인
ADMIN_PASSWORD_HASH=        # npm run hash-password -- '비밀번호'
ADMIN_TOTP_SECRET=          # 선택: 구글 OTP 등 2단계 인증 (npm run gen-key -- totp)
SESSION_SECRET=             # npm run gen-key

# 사이트 주소 (카카오 알림 링크, 카카오 로그인 리다이렉트에 사용)
APP_URL=https://your-site.vercel.app

# 카카오 "나에게 보내기" (developers.kakao.com 앱의 REST API 키)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=        # 앱에서 Client Secret 을 켰을 때만

# 수집기 설정
ROOM_COUNT=1                       # 가동률 계산용 객실 수
GUEST_DATA_RETENTION_DAYS=365      # 이 기간이 지나면 게스트 이름·연락처 익명화
OTP_WAIT_MINUTES=8                 # 2단계 인증 코드 입력을 기다리는 시간
DEBUG_SCREENSHOTS=0                # 1 이면 실패 화면을 저장 (개인정보 포함 주의)
